<div class="epm_container" id="epm_container">
    <div class="epm_email_popup" id="epm_email_popup">
        <span class="epm_title">Please enter your email</span>
        <span class="epm_description">
            We need your email to proceed futher
        </span>
        <input class="epm_input" placeholder="Email Address" id="epm_email_input">
        <button class="epm_submit_btn" id="epm_submit_btn">
            <p class="epm_submit_btn_text">Submit</p>
        </button>
        <div class="epm_alert" id="epm_alert">
            <button type="button" class="epm_alert_close" id="epm_alert_close">
                &times;
            </button>
            <span id="epm_alert_text"></span>
        </div>
        <span class="epm_footer_text">
            You are signing up to receive order updates.
        </span>
    </div>
</div>


 {% schema %}
 {
   "name": "Email",
   "target": "body",
   "stylesheet": "email-popup.css",
   "javascript": "email-popup.js",
   "settings": []
 }
 {% endschema %}