<div class="epm_container" id="epm_container">
    <div class="epm_email_popup" id="epm_email_popup">
        <span class="epm_title">Get 10% off your order</span>
        <span class="epm_description">
            Sign up and unlock your instant discount
        </span>
        <input class="epm_input" placeholder="Email Address" id="epm_email_input">
        <button class="epm_submit_btn" id="epm_submit_btn">
            <p class="epm_submit_btn_text">Claim Discount</p>
        </button>
        <div class="epm_alert" id="epm_alert">
            <button type="button" class="epm_alert_close" id="epm_alert_close">
                &times;
            </button>
            <span id="epm_alert_text">You haven't provided the email.</span>
        </div>
        <span class="epm_cancel_btn_text" id="epm_close_btn">
            No thanks
        </span>
        <span class="epm_footer_text">
            You are signing up to receive communication via email and can
            unsubscribe at any time.
        </span>
    </div>
</div>


 {% schema %}
 {
   "name": "Email",
   "target": "body",
   "stylesheet": "email-popup.css",
   "javascript": "email-popup.js",
   "settings": []
 }
 {% endschema %}