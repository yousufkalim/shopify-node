{
  "name": "shopify-app-node",
  "private": true,
  "scripts": {
    "build": "npm run build:client",
    "build:client": "vite build --outDir dist/client",
    "debug": "node --inspect-brk server/index.js",
    "dev": "cross-env NODE_ENV=development nodemon server/index.js --watch ./server",
    "prepare": "husky install",
    "preserve": "npm run build",
    "serve": "cross-env NODE_ENV=production node server/index.js",
    "start": "npm run serve",
    "test": "vitest --reporter=verbose",
    "deploy": "git reset --hard && git pull origin main && npm i && pm2 restart 0 && pm2 logs 0"
  },
  "type": "module",
  "engines": {
    "node": ">=16.13.0"
  },
  "dependencies": {
    "@apollo/client": "^3.5.10",
    "@shopify/app-bridge": "^2.0.22",
    "@shopify/app-bridge-react": "^2.0.24",
    "@shopify/app-bridge-utils": "^2.0.24",
    "@shopify/polaris": "^9.4.0",
    "@shopify/shopify-api": "^3.0.0",
    "@vitejs/plugin-react": "1.3.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "cross-env": "^7.0.3",
    "dotenv": "^16.0.0",
    "express": "^4.17.3",
    "graphql": "^16.3.0",
    "jsonwebtoken": "^8.5.1",
    "moment": "^2.29.3",
    "mongoose": "^6.2.10",
    "morgan": "^1.10.0",
    "node-cron": "^3.0.0",
    "nodemailer": "^6.7.5",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "serve-static": "^1.15.0",
    "valid-shopify-request": "^1.0.1",
    "vite": "^2.9.1"
  },
  "devDependencies": {
    "supertest": "^6.2.2",
    "vitest": "^0.9.3"
  }
}
